# syntax=docker/dockerfile:1.7
# The GLM-5.3-Flash Databricks AI Runtime image, with the tools the OfficeQA agent uses. Build and push
# it with docker/build.py, which passes the host's CA bundle as the host_ca secret:
#   python docker/build.py --variant air-glm53 --image-tag custom --custom-tag glm53 \
#     --image <registry>/miles-air --push
# Add --build-arg PIP_INDEX_URL=<mirror> where the build cannot reach PyPI.
# The reference stage supplies the pinned CUDA 13 / PyTorch 2.13 binary stack.
# The final image always starts from the pinned Databricks AIR base.
ARG REFERENCE_IMAGE=radixark/miles@sha256:64f67cb1d00ed89c2244defd7a5d99d06a94ef2c2217f9fd0ad9d5519ed1db2d
ARG AIR_BASE=databricksruntime/air@sha256:8da6cc766e745239ed46f573344a6cad351deb2c0caf3135b26e98f20e9197c0

FROM ${REFERENCE_IMAGE} AS build

COPY docker/air/patches/sglang-glm53-150k.patch /tmp/sglang-glm53-150k.patch
COPY docker/patch/fla_kda_hoist_next_power_of_2.patch /tmp/fla-kda.patch

RUN git -C /sgl-workspace/sglang apply /tmp/sglang-glm53-150k.patch

# The FLA source tag is verified against its full commit, then the Miles KDA
# patch is applied before the wheel is built. Neither operation resolves PyPI.
RUN --mount=type=secret,id=host_ca,target=/run/secrets/host_ca,required=true \
    GIT_SSL_CAINFO=/run/secrets/host_ca git clone --depth 1 --branch v0.5.2 \
      https://github.com/fla-org/flash-linear-attention.git /tmp/fla && \
    test "$(git -C /tmp/fla rev-parse HEAD)" = 9c8e42e762fce087c27b673af4922795d9edb85e && \
    patch --fuzz=0 -p1 -d /tmp/fla/fla < /tmp/fla-kda.patch && \
    mkdir -p /wheels && \
    python -m pip wheel --no-deps --no-build-isolation -w /wheels /tmp/fla && \
    python -m pip install --no-deps --force-reinstall --no-index /wheels/flash_linear_attention-0.5.2-*.whl

# This release wheel contains the CUDA 13 sm_100a and sm_103a FlashMLA code.
RUN --mount=type=secret,id=host_ca,target=/run/secrets/host_ca,required=true \
    curl --cacert /run/secrets/host_ca -fL --retry 3 \
      'https://github.com/yueming-yuan/miles-wheels/releases/download/cu130-torch213-x86_64/flash_mla-1.0.0%2Bb7643bd-cp312-cp312-linux_x86_64.whl' \
      -o '/wheels/flash_mla-1.0.0+b7643bd-cp312-cp312-linux_x86_64.whl' && \
    echo 'edf843a8e62c5a385d169293b157025190bea78e293e438403a4c42895530e9b  /wheels/flash_mla-1.0.0+b7643bd-cp312-cp312-linux_x86_64.whl' | sha256sum -c - && \
    python -m pip install --no-deps '/wheels/flash_mla-1.0.0+b7643bd-cp312-cp312-linux_x86_64.whl'

# The backport changes both Python/JIT code and AOT top-k sources. Reinstalling
# only the editable SGLang package would leave the old AOT binary in place.
RUN --mount=type=secret,id=host_ca,target=/run/secrets/host_ca,required=true \
    SSL_CERT_FILE=/run/secrets/host_ca CURL_CA_BUNDLE=/run/secrets/host_ca \
    GIT_SSL_CAINFO=/run/secrets/host_ca \
    CMAKE_ARGS='-DENABLE_BELOW_SM90=OFF -DSGL_KERNEL_ENABLE_FA3=OFF -DSGL_KERNEL_COMPILE_THREADS=2' \
    CMAKE_BUILD_PARALLEL_LEVEL=4 \
      python -m pip wheel --no-deps --no-build-isolation -w /wheels \
      /sgl-workspace/sglang/python/sglang/kernels/aot && \
    python -m pip install --no-deps --force-reinstall --no-index /wheels/sglang_kernel-0.4.6.post1-*.whl

# These prebuilt caches target many GPUs and are regenerated by FlashInfer's
# JIT when a kernel is first used. FA3 is Hopper only; B300 uses FA2/FA4.
# Uninstall their distributions as well as their large payloads so metadata
# does not falsely claim that the optional packages are present.
RUN python -m pip uninstall -y flashinfer-cubin flashinfer-jit-cache flash-attn-3 && \
    rm -f /usr/local/lib/python3.12/dist-packages/__editable__.miles-0.1.0.pth \
          /usr/local/lib/python3.12/dist-packages/__editable___miles_0_1_0_finder.py && \
    rm -rf /usr/local/lib/python3.12/dist-packages/miles-0.1.0.dist-info

FROM ${AIR_BASE} AS runtime
ARG PIP_INDEX_URL=https://pypi.org/simple

# AIR provides the CUDA runtime and EFA/NCCL networking. TileLang, DeepGEMM
# and SGLang compile kernels at run time, so the final image needs real nvcc,
# cuBLAS/NVRTC headers, a C++ compiler and Ninja. Omit the development static
# archives from the final layer to keep the AIR image below 20 GB. bubblewrap is the sandbox the
# OfficeQA agent runs its Python tool in.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      cuda-nvcc-13-0=13.0.88-1 \
      cuda-cudart-dev-13-0=13.0.96-1 \
      libcublas-dev-13-0=13.1.1.3-1 \
      cuda-nvrtc-dev-13-0=13.0.88-1 \
      build-essential=12.10ubuntu1 \
      python3.12-dev=3.12.3-1ubuntu0.17 \
      ninja-build=1.11.1-2 \
      bubblewrap=0.9.0-1ubuntu0.3 && \
    rm -f /usr/local/cuda/targets/x86_64-linux/lib/libcublas_static.a \
          /usr/local/cuda/targets/x86_64-linux/lib/libcublasLt_static.a \
          /usr/local/cuda/targets/x86_64-linux/lib/libnvrtc_static.a \
          /usr/local/cuda/targets/x86_64-linux/lib/libnvrtc-builtins_static.a && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/lib/python3.12/dist-packages/ /opt/venv/lib/python3.12/site-packages/
COPY --from=build /sgl-workspace/sglang/python/ /sgl-workspace/sglang/python/
COPY --from=build /root/Megatron-LM/megatron/ /root/Megatron-LM/megatron/
COPY --from=build /usr/local/bin/ray /opt/venv/bin/ray
COPY --from=build /usr/local/bin/torchrun /opt/venv/bin/torchrun
COPY --from=build /usr/local/bin/hf /opt/venv/bin/hf

# These reference-image packages are outside the GLM AIR path and have broken
# dependency declarations in the merged runtime. Remove them before the full
# dependency gate; the selected rollout transport uses NCCL, not NIXL.
RUN python -m pip uninstall -y nixl megatron-bridge megatron-energon moviepy flash-qla

# The OfficeQA judges authenticate through databricks-sdk, and Miles logs to MLflow, whose Databricks
# client uses protobuf 6, so grpcio-tools matches its ABI. SGLang requires TileLang 0.1.11 and PyTorch
# requires cuDNN 9.20.0.48. bm25s is the OfficeQA agent's search index. --no-deps keeps pip from changing
# the reference stack, so the list names every dependency these packages need.
RUN --mount=type=secret,id=host_ca,target=/run/secrets/host_ca,required=true \
    export PIP_CERT=/run/secrets/host_ca && \
    python -m pip install --no-cache-dir --no-deps \
      databricks-sdk==0.121.0 mlflow-skinny==3.5.0 protobuf==6.33.5 grpcio-tools==1.81.1 \
      bracex==3.0.1 cachetools==6.2.1 cryptography==49.0.0 gitdb==4.0.12 gitpython==3.1.45 \
      importlib-metadata==8.7.0 packaging==25.0 prettytable==3.18.0 pyasn1-modules==0.4.2 \
      pyparsing==3.3.3 smmap==5.0.2 sqlparse==0.5.3 tzdata==2025.3 wcmatch==10.2.1 xattr==1.3.0 \
      bm25s==0.3.11 && \
    python -m pip install --no-cache-dir --no-deps --force-reinstall \
      tilelang==0.1.11 nvidia-cudnn-cu13==9.20.0.48

RUN sed -i '1c#!/opt/venv/bin/python' /opt/venv/bin/ray /opt/venv/bin/torchrun /opt/venv/bin/hf && \
    python -m pip check
